# 忽略 Git 記錄
.git
.gitignore

# 忽略 Docker 自身設定檔
.dockerignore
Dockerfile*

# 忽略環境變數檔案
.env
*.env

# 忽略編譯結果或暫存檔案
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.swp
*.tmp

# 忽略 IDE 設定
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 忽略作業系統產生的檔案
.DS_Store
Thumbs.db

# 忽略 node_modules 或其他外部依賴
node_modules/
venv/
.venv/
dist/
build/
coverage/

# 忽略用於測試的資料夾
tests/